{
 "doctype": "DocType",
 "name": "YOB Application",
 "module": "YOB Auth",
 "autoname": "field:application_code",
 "title_field": "application_name",
 "search_fields": "application_code,application_name,domains",
 "field_order": [
  "application_code",
  "application_name",
  "enabled",
  "domains",
  "allowed_origins",
  "required_profile_doctype",
  "required_role",
  "allow_password_login",
  "allow_email_otp",
  "allow_mobile_otp"
 ],
 "fields": [
  {
   "fieldname": "application_code",
   "fieldtype": "Data",
   "label": "Application Code",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "application_name",
   "fieldtype": "Data",
   "label": "Application Name",
   "reqd": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "domains",
   "fieldtype": "Small Text",
   "label": "Allowed Domains",
   "description": "One host per line, without scheme. Example: myemployee.com"
  },
  {
   "fieldname": "allowed_origins",
   "fieldtype": "Small Text",
   "label": "Extra Allowed Origins",
   "description": "Optional. One full origin per line, including scheme and port. Only needed for callers whose origin is not one of the Allowed Domains above - typically a local dev server, e.g. http://192.168.1.25:4021"
  },
  {
   "fieldname": "required_profile_doctype",
   "fieldtype": "Link",
   "label": "Required Profile DocType",
   "options": "DocType"
  },
  {
   "fieldname": "required_role",
   "fieldtype": "Link",
   "label": "Required Role",
   "options": "Role"
  },
  {
   "fieldname": "allow_password_login",
   "fieldtype": "Check",
   "label": "Allow Password Login",
   "default": "1"
  },
  {
   "fieldname": "allow_email_otp",
   "fieldtype": "Check",
   "label": "Allow Email OTP",
   "default": "1"
  },
  {
   "fieldname": "allow_mobile_otp",
   "fieldtype": "Check",
   "label": "Allow Mobile OTP",
   "default": "0"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  }
 ]
}
